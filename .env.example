# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` (it is already in .gitignore).
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) --------------------------------------
# Also works with any Postgres provider: Neon, Supabase, Railway, etc.
# Use the pooled/direct connection string for server-side queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used by `supabase/schema.sql`. Keep this secret.
SUPABASE_DB_PASSWORD=your-database-password

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create an OAuth 2.0 Client ID of type "Web application" and add this to
# Authorised redirect URIs:
#   http://localhost:3000/auth/callback
#   https://your-domain.com/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Server-only client secret from the same OAuth client.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Mailgun (mailgun.com -> Sending -> Domain settings) ---------------------
# Domain must be verified (add the DNS records Mailgun gives you).
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
# "http://localhost:3000" in development so links work on the sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Verified "From" address on the Mailgun domain.
MAILGUN_FROM="Audiophile Store <orders@mg.yourdomain.com>"

# --- Store ------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=USD
SHIPPING_FLAT_RATE=50
