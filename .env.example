# ---------------------------------------------------------------------------
# Template only - every value here is a PLACEHOLDER.
# Copy to `.env.local` and fill in the real values:
#   cp .env.example .env.local
# NEVER commit `.env.local` (it is already in .gitignore).
#
# There are TWO environments and they differ in exactly three values. Everything
# else is identical:
#
#   Local (.env.local)          Vercel (dashboard)
#   --------------------------  ---------------------------------------------
#   NEXT_PUBLIC_SITE_URL        NEXT_PUBLIC_SITE_URL
#     http://localhost:3000       https://your-vercel-domain.com
#   MAILGUN_DOMAIN              MAILGUN_DOMAIN
#     sandbox*.mailgun.org        mg.yourdomain.com   (verified, not sandbox)
#   MAILGUN_FROM                MAILGUN_FROM
#     orders@sandbox*.mailgun     orders@mg.yourdomain.com
#
# Vercel does NOT read `.env.local` - it is git-ignored, so every value below
# must be added by hand in Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) --------------------------------------
# Also works with any Postgres provider: Neon, Supabase, Railway, etc.
# Use the pooled/direct connection string for server-side queries.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# `SUPABASE_SERVICE_ROLE_KEY` is deliberately absent. It is not used by this app,
# and it bypasses RLS entirely - a leaked service-role key hands over the whole
# database. Order writes use the anon key plus the signed-in user's cookie, and
# row-level security enforces ownership.
# LOCAL DEV ONLY - used to run `supabase/schema.sql`. The app never reads it, so
# do NOT add it to Vercel.
SUPABASE_DB_PASSWORD=your-database-password

# --- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ---
# Create an OAuth 2.0 Client ID of type "Web application".
# Authorised redirect URIs must contain EVERY host you sign in from - missing one
# is the most common cause of a sign-in that starts but never completes:
#   http://localhost:3000/auth/callback                      (local dev)
#   https://your-vercel-domain.com/auth/callback             (production)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Server-only client secret from the same OAuth client.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Site URL ----------------------------------------------------------------
# Where the app lives. Drives the Google OAuth redirect and the "View your order"
# link in every confirmation email. If this is wrong, sign-in appears to succeed
# then bounces the customer to localhost and the email links are dead.
#   local    -> http://localhost:3000
#   Vercel   -> https://your-vercel-domain.com
# Leave it unset on Vercel and it falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mailgun (mailgun.com -> Sending -> Domain settings) ---------------------
# On the FREE plan you get a sandbox domain that ONLY delivers to addresses you
# authorise under Sending -> Sandbox domain -> Authorized recipients (each must
# also be verified). It still returns HTTP 200 for everyone else and then drops
# the mail, so a 2xx is NOT proof of delivery - the app detects this and reports
# it honestly rather than claiming an email is on its way.
# To email real customers you must verify a domain whose DNS you control, e.g.
# `mg.yourdomain.com`, then set MAILGUN_DOMAIN and MAILGUN_FROM to match it.
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sandbox (testing):
#   MAILGUN_DOMAIN=sandboxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.mailgun.org
# Production (after verification):
MAILGUN_DOMAIN=mg.yourdomain.com
# Verified "From" address on the MAILGUN_DOMAIN above. Keep the quotes - this is
# a full RFC 5322 address, not just an email.
MAILGUN_FROM="Sonora Store <orders@mg.yourdomain.com>"
# Auto-detected from MAILGUN_DOMAIN - a sandbox domain only delivers to the
# addresses authorised in the Mailgun dashboard. Set to false once MAILGUN_DOMAIN
# points at a real verified domain, so the app stops reporting that non-recipients
# will be emailed. Normally you do not need to set this at all.
# MAILGUN_SANDBOX_LIMITS=false

# --- Store -------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=USD
SHIPPING_FLAT_RATE=50

# Contact address shown on /terms and /privacy. Point this at a real, monitored
# inbox before launch - otherwise the legal pages advertise an address nobody
# reads. Falls back to support@<MAILGUN_DOMAIN> when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# --- Non-env checklist for Vercel --------------------------------------------
# Vercel will NOT read `.env.local`, so every variable above must be added by
# hand in Project -> Settings -> Environment Variables (skip SUPABASE_DB_PASSWORD).
# Then add your production URL to BOTH of these, or Google sign-in will fail:
#   1. Google Cloud Console -> Credentials -> your OAuth client
#      -> Authorised redirect URIs  ->  https://your-domain.com/auth/callback
#   2. Supabase -> Authentication -> URL Configuration -> Redirect URLs
#      ->  https://your-domain.com/auth/callback
# Verify real email delivery with:  npm run check:email -- some.address@gmail.com
